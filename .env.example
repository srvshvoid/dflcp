# FedForge optional deployment variables. The CPU smoke path does not require them.
FEDFORGE_RUNS_ROOT=runs
FEDFORGE_API_HOST=127.0.0.1
FEDFORGE_API_PORT=8001
# Set this in any shared or non-local deployment. When set, mutating routes
# and sensitive federation metadata require Authorization: Bearer <token>.
# FEDFORGE_API_TOKEN=replace-with-a-long-random-secret
# DATABASE_URL=postgresql://user:password@postgres:5432/fedforge
# REDIS_URL=redis://redis:6379/0
